# Optional: copy this file to .env for overrides. No .env file is required.
# dev:server and start:server load it automatically.
# Existing shell environment variables take precedence over .env values.

# Server binding and the exact browser origin used for wallet sign-in.
# Update APP_ORIGIN too if you change the port or hostname.
# Non-loopback origins require HTTPS (typically through a reverse proxy).
APP_HOST=127.0.0.1
APP_PORT=3003
APP_ORIGIN=http://localhost:3003

# Optional overrides for automatically generated, privately saved secrets.
# Preserve existing secrets when upgrading. Never use blank overrides.
# BETTER_AUTH_SECRET=

# Optional overrides; defaults are the repository's static/ and .build/ directories.
# APP_STATIC_DIR=static
# APP_BUILD_DIR=.build

# Credential encryption key: exactly 32 bytes as 64 hexadecimal characters.
# Existing installations without saved configuration must supply their original key.
# Back up the configuration with the database; losing the key loses access to
# stored credentials. Environment overrides do not replace an existing saved key.
# AGENTS_ENCRYPTION_KEY=
