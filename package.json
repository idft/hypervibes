{
  "name": "hypervibes",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:js": "./node_modules/esbuild/bin/esbuild assets/app.ts assets/login.ts --bundle --outdir=static/dist --minify",
    "build:css": "tailwindcss -i assets/app.css -o static/dist/app.css --minify",
    "build": "pnpm build:js && pnpm build:css",
    "lint": "eslint assets",
    "lint:fix": "eslint assets --fix",
    "typecheck": "tsc --noEmit",
    "test:js": "vitest run --environment jsdom"
  },
  "dependencies": {
    "htmx-ext-sse": "2.2.4",
    "htmx.org": "2.0.10",
    "timeago.js": "4.0.2",
    "viem": "^2.55.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.1.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.10"
  }
}
