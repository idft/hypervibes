{
  "name": "vibetrading",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:js": "esbuild assets/app.ts --bundle --outfile=static/dist/app.js --minify",
    "build:css": "tailwindcss -i assets/app.css -o static/dist/app.css --minify",
    "build": "pnpm build:js && pnpm build:css",
    "lint": "eslint assets",
    "lint:fix": "eslint assets --fix"
  },
  "dependencies": {
    "htmx-ext-sse": "2.2.4",
    "htmx.org": "2.0.10",
    "timeago.js": "4.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.1.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.61.1"
  }
}
