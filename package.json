{
  "name": "hypervibes",
  "version": "0.4.0",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idft/hypervibes.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.23.3"
  },
  "bin": {
    "hypervibes": "./bin/hypervibes.js"
  },
  "files": [
    "bin/",
    "dist/",
    "docs/*.md",
    ".build/server/",
    ".build/client/",
    "static/",
    "!static/dist/",
    "scripts/check-node.mjs"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/main.ts --dev",
    "screenshot": "node scripts/capture-screenshot.mjs",
    "test:screenshot": "node --test scripts/screenshot.test.mjs",
    "build": "node scripts/check-node.mjs && pnpm build:app && pnpm build:server",
    "build:app": "pnpm generate:routes && vite build --config vite.app.config.ts",
    "build:server": "node scripts/build-server.mjs",
    "prepack": "pnpm build",
    "generate:routes": "tsr generate",
    "generate:auth": "auth generate --config src/db/auth-generation.ts --output src/db/auth-schema.ts --yes",
    "generate:migrations": "drizzle-kit generate --config drizzle.config.ts",
    "start": "pnpm build && node bin/hypervibes.js",
    "start:built": "node bin/hypervibes.js",
    "test": "pnpm test:server && pnpm test:startup && pnpm test:container && pnpm test:screenshot",
    "test:container": "node --test scripts/container.test.mjs",
    "test:startup": "node --test scripts/startup.test.mjs",
    "test:build": "node --test scripts/build.test.mjs",
    "test:package": "node --test scripts/package.test.mjs",
    "typecheck:server": "tsr generate && tsc --project tsconfig.server.json",
    "lint:server": "eslint src vite.app.config.ts vitest.server.config.ts drizzle.config.ts",
    "test:server": "vitest run --config vitest.server.config.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.15",
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-codemode": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@fastify/static": "10.1.8",
    "@nktkas/hyperliquid": "0.33.3",
    "@tanstack/react-query": "5.105.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.4",
    "better-auth": "1.7.15",
    "drizzle-orm": "1.0.0-rc.4",
    "fancy-canvas": "2.1.0",
    "fastify": "5.12.7",
    "grammy": "^1.46.0",
    "lightweight-charts": "5.2.1",
    "pinets": "0.13.1",
    "pino-pretty": "^13.2.0",
    "proper-lockfile": "4.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "srvx": "1.0.8",
    "timeago.js": "4.0.2",
    "typebox": "1.4.3",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-cli": "1.167.46",
    "@types/node": "^22.20.5",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "auth": "1.7.15",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "playwright": "1.64.1",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "8.3.5",
    "vitest": "^5.0.5"
  }
}
