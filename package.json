{
  "name": "hypervibes",
  "version": "0.4.0-alpha",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.23.3"
  },
  "scripts": {
    "dev:server": "node --env-file-if-exists=.env --import tsx src/main.ts --dev",
    "build:app": "pnpm generate:routes && vite build --config vite.app.config.ts",
    "generate:routes": "tsr generate",
    "generate:auth": "auth generate --config src/db/auth-generation.ts --output src/db/auth-schema.ts --yes",
    "generate:migrations": "drizzle-kit generate --config drizzle.config.ts",
    "start:server": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "typecheck:server": "tsr generate && tsc --project tsconfig.server.json",
    "lint:server": "eslint src vite.app.config.ts vitest.server.config.ts drizzle.config.ts",
    "test:server": "vitest run --config vitest.server.config.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.10",
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-codemode": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@fastify/static": "10.1.6",
    "@nktkas/hyperliquid": "0.33.3",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.2",
    "better-auth": "1.7.10",
    "drizzle-orm": "1.0.0-rc.4",
    "fancy-canvas": "2.1.0",
    "fastify": "5.12.7",
    "grammy": "^1.46.0",
    "lightweight-charts": "5.2.1",
    "pinets": "0.12.1",
    "pino-pretty": "^13.2.0",
    "proper-lockfile": "4.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "srvx": "1.0.5",
    "timeago.js": "4.0.2",
    "viem": "^2.57.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "4.3.1",
    "@tanstack/router-cli": "1.167.44",
    "@types/node": "22.20.5",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "auth": "1.7.10",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "8.1.5",
    "vitest": "^4.1.12"
  }
}
